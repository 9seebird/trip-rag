# ── 공공데이터포털 (한국관광공사 국문 관광정보) ──────────────────
# 포털 마이페이지의 "일반 인증키(Decoding)" 를 넣으세요.
# Encoding 키(%2B, %3D 가 섞인 것)를 넣어도 코드가 알아서 처리합니다.
TOUR_API_KEY=
TOUR_BASE=https://apis.data.go.kr/B551011/KorService2
TOUR_APP_NAME=triprag
# 하루 호출 한도 (개발계정 1000). 운영계정 전환하면 올리세요.
TOUR_DAILY_LIMIT=1000

# ── 모델 제공처 ───────────────────────────────────────────────
# bizrouter 또는 gemini. gemini 면 GEMINI_API_KEY 만 있으면 된다 (aistudio.google.com 에서 발급).
# 제공처를 바꾸면 임베딩 모델이 달라지므로 build_index 를 다시 돌려야 검색이 된다.
# 아래 EMBED_MODEL / RERANK_MODEL / CHAT_MODEL 은 비워 두면 제공처별 기본값을 쓴다.
LLM_PROVIDER=bizrouter
GEMINI_API_KEY=

# ── 비즈라우터 (임베딩 / 리랭킹 / 생성) ────────────────────────
BIZROUTER_API_KEY=
BIZROUTER_BASE=https://api.bizrouter.ai/v1
EMBED_MODEL=
EMBED_DIM=1024
RERANK_MODEL=
CHAT_MODEL=

# ── DB ────────────────────────────────────────────────────────
POSTGRES_DB=triprag
POSTGRES_USER=triprag
POSTGRES_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5433
API_PORT=8080

# ── 운영 배포 (docker-compose.prod.yml) ────────────────────────
# 1 이면 API 문서·통계를 닫는다. 운영 compose 는 자동으로 1.
PUBLIC=0
# 카카오 지도 JavaScript 키 (developers.kakao.com → 내 애플리케이션 → 앱 키).
# 비워 두면 지도 없이 목록만 보인다. 플랫폼 > Web 에 사이트 도메인을 등록해야 지도가 뜬다.
KAKAO_JS_KEY=
# 사용량 제한 (검색·코스 호출마다 모델 비용이 나간다)
RATE_PER_MIN=12
DAILY_REQUEST_LIMIT=1500
# Cloudflare Tunnel 토큰 (노트북 배포, docker-compose.prod.yml 의 tunnel)
TUNNEL_TOKEN=

# ── 운영 부가 기능 ─────────────────────────────────────────────
# 관리 화면 /admin 의 비밀번호 (길고 무작위로). 비워 두면 관리 화면·API 를 닫는다
ADMIN_TOKEN=
# 매일 수집 감시 — healthchecks.io 에서 체크를 만들고 Ping URL 을 넣는다 (예: https://hc-ping.com/uuid)
HC_PING_URL=
# 날씨(기상청 단기예보). 공공데이터포털에서 '기상청_단기예보 조회서비스' 활용신청이 따로 필요.
# 비워 두면 TOUR_API_KEY 를 쓴다 (같은 계정이면 키가 같다). 신청 전이면 화면에 날씨만 안 나온다
WEATHER_API_KEY=
# 반려동물 동반여행(KorPetTourService2)·무장애 여행(KorWithService2) 하루 호출 한도.
# 공공데이터포털에서 서비스마다 활용신청이 따로 필요하고, 한도도 따로다 (개발계정 1,000)
PET_DAILY_LIMIT=950
ACCESS_DAILY_LIMIT=950
# 하이브리드 검색에서 키워드 순위의 가중치 (의미 = 1.0). 평가(eval.run_eval)로 맞춘다
HYBRID_KW_WEIGHT=0.7
