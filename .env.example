# ════════════════════════════════════════════════════════════════
#  반나절 (trip-rag) 설정 견본
#  cp .env.example .env 로 복사해서 빈 칸을 채운다. .env 는 git 에 올리지 않는다
# ════════════════════════════════════════════════════════════════

# ── 관광 데이터 (공공데이터포털 · 한국관광공사 국문 관광정보) ──────
# 마이페이지의 "일반 인증키(Decoding)". Encoding 키(%2B 등)를 넣어도 코드가 처리한다
TOUR_API_KEY=
TOUR_BASE=https://apis.data.go.kr/B551011/KorService2
TOUR_APP_NAME=triprag
# 하루 호출 한도 (개발계정 1000). 운영계정으로 바꾸면 올린다
TOUR_DAILY_LIMIT=1000
# 같은 포털의 다른 서비스들. 서비스마다 활용신청과 하루 한도가 따로다 (개발계정 1,000)
# 반려동물 동반여행(KorPetTourService2) · 무장애 여행(KorWithService2)
PET_DAILY_LIMIT=950
ACCESS_DAILY_LIMIT=950
# 혼잡도 예측(관광지 집중률, TatsCnctrRateService, 포털 15128555)
CROWD_DAILY_LIMIT=300
# 혼잡도용 법정동 코드를 채우려고 예전 목록을 다시 받을 때 하루에 쓸 TourAPI 호출 상한 (한 번 채우면 끝)
CROWD_CODES_BUDGET=200
# 날씨(기상청 단기예보). 활용신청이 따로 필요. 비우면 TOUR_API_KEY 를 쓴다 (같은 계정이면 키가 같다)
# 신청 전이면 화면에 날씨만 안 나온다
WEATHER_API_KEY=

# ── AI 모델 ──────────────────────────────────────────────────
# gemini 또는 bizrouter. 지금은 Gemini 무료 키 하나로 임베딩(검색)·코스 생성을 한다 (aistudio.google.com)
# 제공처를 바꾸면 임베딩이 달라져 build_index 를 다시 돌려야 검색이 된다
LLM_PROVIDER=gemini
GEMINI_API_KEY=
# 비워 두면 제공처 기본 모델. EMBED_DIM 은 DB 벡터 크기라 한번 정하면 바꾸지 않는다
EMBED_MODEL=
EMBED_DIM=1024
RERANK_MODEL=
CHAT_MODEL=
# 하이브리드 검색에서 키워드 순위의 가중치 (의미 = 1.0). 평가(eval.run_eval)로 맞춘다
HYBRID_KW_WEIGHT=0.7

# ── 코스 생성 백업 (집 PC Ollama) ─────────────────────────────
# 주 모델이 429(무료 한도)·5xx 로 거절할 때만 이 서버로 한 번 더 보낸다. 비우면 꺼짐
# 집 PC 에서 OLLAMA_HOST=0.0.0.0 설정 + 방화벽 11434 허용 후 http://<집 PC IP>:11434/v1
FALLBACK_CHAT_BASE=
FALLBACK_CHAT_MODEL=gemma4:12b
FALLBACK_CHAT_TIMEOUT=30

# ── 카카오 (developers.kakao.com → 내 애플리케이션 → 앱 키) ──────
# 같은 앱의 키 두 개. 앱의 [카카오맵] 사용 설정이 ON 이어야 한다
# JavaScript 키: 화면의 지도. 플랫폼 > Web 에 사이트 도메인 등록 필요. 비우면 지도 없이 목록만
KAKAO_JS_KEY=
# REST API 키: 반나절 데이터에 없는 가게(가맥집 등)를 카카오 장소 검색으로 보충 (app/kakao.py). 비우면 꺼짐
KAKAO_REST_KEY=
KAKAO_DAILY_LIMIT=3000

# ── DB ───────────────────────────────────────────────────────
POSTGRES_DB=triprag
POSTGRES_USER=triprag
POSTGRES_PASSWORD=change-me
DB_HOST=localhost
DB_PORT=5433
API_PORT=8080

# ── DB 백업 (scripts/backup_db.sh) — 비우면 기본값 ──────────────
BACKUP_DIR=            # 노트북 안 보관 폴더 (기본 ~/backups/trip-rag, 14일 보관)
BACKUP_NAS_DIR=        # NAS 를 마운트한 폴더, 예: /mnt/nas/backup/trip-rag (60일 보관). 비우면 NAS 복사 안 함
HC_BACKUP_URL=         # healthchecks.io 백업용 체크 주소 (선택)

# ── 운영 ─────────────────────────────────────────────────────
# 1 이면 API 문서·통계를 닫는다 (운영 compose 는 자동으로 1)
PUBLIC=0
# 사용량 제한 (검색·코스마다 모델 호출이 나간다)
RATE_PER_MIN=12
DAILY_REQUEST_LIMIT=1500
# 관리 화면 /admin 의 비밀번호 (길고 무작위로). 비우면 관리 화면·API 를 닫는다
ADMIN_TOKEN=
# 매일 수집 감시 — healthchecks.io 에서 체크를 만들고 Ping URL 을 넣는다 (예: https://hc-ping.com/uuid)
HC_PING_URL=

# ── 선택 ─────────────────────────────────────────────────────
# 비즈라우터 (LLM_PROVIDER=bizrouter 일 때만). 지금 운영에서는 안 쓴다
BIZROUTER_API_KEY=
BIZROUTER_BASE=https://api.bizrouter.ai/v1
# Cloudflare Tunnel 토큰 (docker-compose.prod.yml 의 tunnel 프로필). 노트북은 cloudflared 서비스를 따로 써서 비워 둔다
TUNNEL_TOKEN=
